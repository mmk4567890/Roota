# SQLite path for session event storage (default: backend/data/roota.db)
ROOTA_DB_PATH=

# Observation parser: "keyword" (default, offline) or "anthropic"
ROOTA_PARSER=keyword

# Required when ROOTA_PARSER=anthropic. Never commit a real key.
ANTHROPIC_API_KEY=

# Anthropic model id (default: claude-sonnet-5-5)
ROOTA_LLM_MODEL=claude-sonnet-5-5

# Persistent Chroma directory for ingested manuals (default: backend/data/chroma)
ROOTA_CHROMA_DIR=

# SQLite docs registry (default: backend/data/docs.db)
ROOTA_DOCS_DB_PATH=
